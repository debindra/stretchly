{
  "manifest_version": 3,
  "name": "Stretchly",
  "version": "0.1.0",
  "description": "Instant relief for desk workers — in under 2 minutes",
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Stretchly"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "notifications", "tabs"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon16.png",
    "128": "icons/icon128.png"
  }
}
